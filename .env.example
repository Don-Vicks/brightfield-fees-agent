# Paystack TEST secret key (Dashboard > Settings > API Keys & Webhooks, Test mode).
# Leave empty to run in MOCK mode (no Paystack, fake checkout page, in-memory only).
# Live keys (sk_live_...) are refused on purpose: the exercise allows test keys only.
PAYSTACK_SECRET_KEY=

# Shared secret Chord sends with every tool call (header: x-api-key or Authorization: Bearer).
# Generate one with: openssl rand -hex 24
TOOL_API_KEY=

# Optional. Public URL of this API, used for the Paystack callback page.
# If empty it is worked out from the request headers.
PUBLIC_BASE_URL=

# Optional. Only Paystack transactions created on/after this date count towards the term.
TERM_START=2026-09-01

# Optional. Some tool platforms hide the body of non-2xx responses from the agent.
# If the agent says "the tool failed" instead of reading the error message, set this to true:
# errors then come back as HTTP 200 with ok:false.
ERRORS_AS_200=false

# Optional. Allow ?key=... instead of a header, for platforms that can't send custom headers.
ALLOW_KEY_IN_QUERY=false

# Optional. Force mock mode even when a key is set.
MOCK_PAYSTACK=false

# Optional. Parent check: every student record has the parent's WhatsApp number.
# When a tool call includes parent_phone, the API only answers for that parent's children.
# Set to true once Chord passes the sender's number, so calls WITHOUT parent_phone are refused too.
REQUIRE_PARENT_PHONE=false

# Optional. Comma-separated numbers treated as the parent of EVERY student (for testers).
DEMO_PARENT_PHONES=
